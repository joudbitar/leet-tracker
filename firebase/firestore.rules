rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // all of a user's progress + profile in one private doc
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // public leaderboard entries — anyone reads, only the owner writes theirs
    match /board/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
